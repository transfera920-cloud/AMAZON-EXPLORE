---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../config/site';

const chapters = await getCollection('chapters');
const sortedChapters = chapters.sort((a, b) => a.data.chapter - b.data.chapter);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const breadcrumbs = [
  { name: '首頁', url: 'https://amazon-hike.com/' },
  { name: 'intro', url: 'https://amazon-hike.com/intro/' },
  { name: '進階探勘教育系統', url: `${SITE_CONFIG.canonicalBase}` },
  { name: '我的進度', url: `${SITE_CONFIG.canonicalBase}progress/` },
];
---

<Layout
  title="我的進度｜章節完成度與能力剖面｜進階探勘教育系統｜亞馬遜國家山岳協會"
  description="追蹤 12 章教材完成度、能力自評剖面與個人判斷筆記，資料保存在本機瀏覽器。"
  canonicalPath="progress/"
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <div class="mx-auto max-w-[1400px] px-4 py-8 space-y-8">
    <header class="border border-[var(--border)] bg-[var(--card)] p-6 rounded-sm space-y-2">
      <span class="font-mono text-xs text-[var(--primary)] font-semibold">STUDY TRACKER // LOCAL STORAGE</span>
      <h1 class="text-2xl font-bold">我的進度</h1>
      <p class="text-sm text-[var(--muted-foreground)]">
        追蹤 12 章教材閱讀完成狀態、能力自評剖面與個人判讀筆記。所有資料僅保存於您目前裝置的本機瀏覽器。
      </p>
    </header>

    {/* Completion Status Bar */}
    <section class="border border-[var(--border)] bg-[var(--card)] p-6 rounded-sm space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold">章節完成度</h2>
        <span id="progress-percentage" class="font-mono text-xl font-bold text-[var(--primary)]">0% (0 / 12)</span>
      </div>

      <div class="w-full bg-[var(--surface)] h-3 rounded-full overflow-hidden border border-[var(--border)]">
        <div id="progress-bar" class="bg-[var(--primary)] h-full w-0 transition-all duration-300"></div>
      </div>

      {/* Chapters list with check status */}
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 pt-2" id="chapter-progress-list">
        {sortedChapters.map(ch => (
          <li class="border border-[var(--border)] bg-[var(--surface)] p-3 rounded-sm flex items-center justify-between gap-3">
            <div class="flex items-center gap-2 overflow-hidden">
              <span 
                class="chapter-check-icon w-5 h-5 rounded-full border border-[var(--border)] flex items-center justify-center text-xs shrink-0 font-bold"
                data-ch-id={ch.id}
              >
                ◯
              </span>
              <a 
                href={`${base}/curriculum/${ch.id}/`} 
                class="text-xs font-medium text-[var(--foreground)] hover:text-[var(--primary)] truncate"
              >
                第{ch.data.chapter}章 {ch.data.title}
              </a>
            </div>

            <button
              type="button"
              data-toggle-id={ch.id}
              class="toggle-ch-btn px-2 py-1 text-[11px] rounded-xs border border-[var(--border)] hover:bg-[var(--secondary)] text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors cursor-pointer shrink-0"
            >
              切換狀態
            </button>
          </li>
        ))}
      </ul>
    </section>

    {/* Notes Notepad */}
    <section class="border border-[var(--border)] bg-[var(--card)] p-6 rounded-sm space-y-4">
      <div class="flex items-center justify-between border-b border-[var(--border)] pb-2">
        <div>
          <h2 class="text-lg font-bold">判斷筆記</h2>
          <p class="text-xs text-[var(--muted-foreground)]">在此記錄您在各章習題或實際探勘中的情境推演心得</p>
        </div>
        <button
          id="save-notes-btn"
          type="button"
          class="px-3 py-1.5 bg-[var(--primary)] text-[var(--primary-foreground)] text-xs font-semibold rounded-sm hover:opacity-90 transition-opacity cursor-pointer"
        >
          儲存筆記
        </button>
      </div>

      <textarea
        id="notes-area"
        rows="8"
        class="w-full bg-[var(--surface)] border border-[var(--border)] rounded-sm p-3 text-xs sm:text-sm text-[var(--foreground)] focus:border-[var(--primary)] focus:outline-none leading-relaxed font-sans"
        placeholder="在此輸入您的個人判讀心得、行程假設拆解範本或疑問..."
      ></textarea>

      <div class="flex items-center justify-between text-xs text-[var(--muted-foreground)]">
        <span id="save-status">編輯後請點選右上角「儲存筆記」</span>
        <button
          id="clear-all-btn"
          type="button"
          class="text-[var(--destructive)] hover:underline cursor-pointer"
        >
          清空本機所有進度與筆記
        </button>
      </div>
    </section>
  </div>
</Layout>

<script>
  (function() {
    try {
      const chKey = 'hike_chapter_progress';
      const notesKey = 'hike_progress_notes';

      let chProgress: Record<string, boolean> = {};
      try {
        const stored = localStorage.getItem(chKey);
        if (stored) chProgress = JSON.parse(stored);
      } catch (e) {}

      function renderProgress() {
        const total = 12;
        const completed = Object.keys(chProgress).filter(k => chProgress[k]).length;
        const pct = Math.round((completed / total) * 100);

        const pctEl = document.getElementById('progress-percentage');
        const barEl = document.getElementById('progress-bar');

        if (pctEl) pctEl.textContent = `${pct}% (${completed} / ${total})`;
        if (barEl) barEl.style.width = `${pct}%`;

        document.querySelectorAll('.chapter-check-icon').forEach(icon => {
          const id = icon.getAttribute('data-ch-id');
          if (id && chProgress[id]) {
            icon.textContent = '✓';
            icon.classList.add('bg-[var(--terrain)]/20', 'text-[var(--terrain)]', 'border-[var(--terrain)]');
          } else {
            icon.textContent = '◯';
            icon.classList.remove('bg-[var(--terrain)]/20', 'text-[var(--terrain)]', 'border-[var(--terrain)]');
          }
        });
      }

      document.querySelectorAll('.toggle-ch-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          try {
            const id = btn.getAttribute('data-toggle-id');
            if (id) {
              chProgress[id] = !chProgress[id];
              localStorage.setItem(chKey, JSON.stringify(chProgress));
              renderProgress();
            }
          } catch (err) {
            console.error('Toggle error', err);
          }
        });
      });

      // Notes
      const notesArea = document.getElementById('notes-area') as HTMLTextAreaElement | null;
      const saveBtn = document.getElementById('save-notes-btn');
      const statusEl = document.getElementById('save-status');

      try {
        const savedNotes = localStorage.getItem(notesKey);
        if (notesArea && savedNotes) notesArea.value = savedNotes;
      } catch (e) {}

      saveBtn?.addEventListener('click', () => {
        try {
          if (notesArea) {
            localStorage.setItem(notesKey, notesArea.value);
            if (statusEl) {
              statusEl.textContent = '✓ 筆記已成功儲存至本機！ (' + new Date().toLocaleTimeString() + ')';
            }
          }
        } catch (e) {
          console.error('Save notes error', e);
        }
      });

      // Clear all
      document.getElementById('clear-all-btn')?.addEventListener('click', () => {
        if (confirm('確定要清空本機儲存的所有進度與筆記嗎？此操作無法還原。')) {
          try {
            localStorage.removeItem(chKey);
            localStorage.removeItem(notesKey);
            localStorage.removeItem('hike_diagnostic_scores');
            chProgress = {};
            if (notesArea) notesArea.value = '';
            renderProgress();
            if (statusEl) statusEl.textContent = '進度已全數重置。';
          } catch (e) {}
        }
      });

      renderProgress();
    } catch (err) {
      console.error('Progress page init error', err);
    }
  })();
</script>
