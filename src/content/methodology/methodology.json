    "stopLossProcedure": [
      {
        "step": 1,
        "title": "行前議定非現場談判",
        "note": "在出發前把撤退條件寫下來並獲得全體確認。現場面對沉沒成本時，人的評估能力會嚴重失真。"
      },
      {
        "step": 2,
        "title": "量化與可檢查的指標",
        "note": "避免使用「情況不妙就撤」這種模糊詞彙；改用「時間超過 14:00」、「垂直高度未上升 100m」、「能見度低於 20m」等客觀訊號。"
      },
      {
        "step": 3,
        "title": "指派唱反調者（Devil’s Advocate）",
        "note": "隊伍中需有專人負責在決策節點提出「反對繼續」的論據，破除群體盲思（Groupthink）。"
      },
      {
        "step": 4,
        "title": "啟動即執行，不容許「再試一下」",
        "note": "一旦觸發門檻，唯一的程序就是執行撤退，禁止現場重新議定門檻。"
      }
    ]
