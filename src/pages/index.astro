---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG, generateCourseJsonLd } from '../config/site';

const chapters = await getCollection('chapters');
const sortedChapters = chapters.sort((a, b) => a.data.chapter - b.data.chapter);

const methodCollection = await getCollection('methodology');
const methodology = methodCollection[0]?.data;

const diagCollection = await getCollection('diagnostic');
const diagnostic = diagCollection[0]?.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const breadcrumbs = [
  { name: '首頁', url: 'https://amazon-hike.com/' },
  { name: 'intro', url: 'https://amazon-hike.com/intro/' },
  { name: '進階探勘教育系統', url: `${SITE_CONFIG.canonicalBase}` },
];

const courseJsonLd = generateCourseJsonLd(sortedChapters.map(c => ({
  no: c.data.chapter,
  id: c.id,
  title: c.data.title,
  subtitle: c.data.subtitle,
})));
---

<Layout
  title="進階探勘教育系統｜亞馬遜國家山岳協會"
  description="以地形、植被、地質、水源、天氣與風險決策為主軸的進階登山探勘教案系統：12 章方法論、案例庫、判讀練習與能力分級診斷。"
  canonicalPath=""
  breadcrumbs={breadcrumbs}
  jsonLd={courseJsonLd}
>
  <div class="mx-auto max-w-[1400px] px-4 py-8 space-y-12">
    {/* Hero Section */}
    <section class="border border-[var(--border)] bg-[var(--card)] p-6 lg:p-8 rounded-sm">
      <div class="max-w-4xl space-y-4">
        <div class="flex items-center gap-2">
          <span class="inline-block px-2 py-0.5 text-xs font-mono text-[var(--primary)] border border-[var(--primary)] rounded-xs">
            亞馬遜國家山岳協會・教案系統
          </span>
        </div>

        <h1 class="text-2xl lg:text-3xl font-bold leading-snug">
          進階登山教育｜探勘思維、山域判讀與風險決策教案系統
        </h1>

        <p class="text-sm lg:text-base leading-relaxed text-[var(--muted-foreground)]">
          以「資訊依賴 → 自主決策」為主軸的 12 章完整教材。從地圖解析度限制、等高線之外的微地形、獸徑路網辨識、植被線性缺口、谷線地質判讀，到長天數天氣風險與團隊停損制度。
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href={`${base}/curriculum/`}
            class="px-4 py-2 bg-[var(--primary)] text-[var(--primary-foreground)] font-semibold text-xs rounded-sm hover:opacity-90 transition-opacity"
          >
            瀏覽 12 章課程 →
          </a>
          <a
            href={`${base}/diagnostic/`}
            class="px-4 py-2 border border-[var(--border)] bg-[var(--surface)] text-[var(--foreground)] text-xs rounded-sm hover:bg-[var(--secondary)] transition-colors"
          >
            能力分級診斷
          </a>
          <a
            href={`${base}/methodology/`}
            class="px-4 py-2 border border-[var(--border)] bg-[var(--surface)] text-[var(--foreground)] text-xs rounded-sm hover:bg-[var(--secondary)] transition-colors"
          >
            13 步決策模型
          </a>
          <a
            href={`${base}/cases/`}
            class="px-4 py-2 border border-[var(--border)] bg-[var(--surface)] text-[var(--foreground)] text-xs rounded-sm hover:bg-[var(--secondary)] transition-colors"
          >
            案例庫 (36 例)
          </a>
          <a
            href={`${base}/practice/`}
            class="px-4 py-2 border border-[var(--border)] bg-[var(--surface)] text-[var(--foreground)] text-xs rounded-sm hover:bg-[var(--secondary)] transition-colors"
          >
            判讀練習 (50 題)
          </a>
        </div>
      </div>
    </section>

    {/* Section 1: Curriculum Overview */}
    <section id="curriculum-overview" class="space-y-4">
      <div class="flex items-center justify-between border-b border-[var(--border)] pb-2">
        <div>
          <h2 class="text-lg font-bold">課程結構：12 章</h2>
          <p class="text-xs text-[var(--muted-foreground)]">點擊章節名稱瀏覽獨立內容與判讀重點</p>
        </div>
        <a href={`${base}/curriculum/`} class="text-xs text-[var(--primary)] hover:underline">
          查看完整目錄 →
        </a>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 list-none p-0">
        {sortedChapters.map(ch => (
          <li class="border border-[var(--border)] bg-[var(--card)] p-4 rounded-sm hover:border-[var(--primary)] transition-colors flex flex-col justify-between">
            <div class="space-y-2">
              <span class="font-mono text-xs text-[var(--primary)]">
                CHAPTER {String(ch.data.chapter).padStart(2, '0')}
              </span>
              <h3 class="text-base font-bold">
                <a href={`${base}/curriculum/${ch.id}/`} class="hover:text-[var(--primary)] transition-colors">
                  第{ch.data.chapter}章 {ch.data.title}
                </a>
              </h3>
              <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                {ch.data.subtitle}
              </p>
              <div class="flex flex-wrap gap-1 pt-1">
                {ch.data.tags.slice(0, 3).map(tag => (
                  <span class="px-1.5 py-0.5 border border-[var(--border)] rounded-xs font-mono text-[10px] text-[var(--muted-foreground)]">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-[var(--border)] flex justify-between items-center text-xs">
              <a href={`${base}/curriculum/${ch.id}/`} class="text-[var(--primary)] hover:underline font-medium">
                第{ch.data.chapter}章 {ch.data.title} →
              </a>
              {ch.id === 'ch01' ? (
                <span class="text-[10px] text-[var(--terrain)]">● 全文可讀</span>
              ) : (
                <span class="text-[10px] text-[var(--muted-foreground)]">樣板待匯</span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    {/* Section 2: 13-step methodology */}
    {methodology && (
      <section id="methodology-preview" class="border border-[var(--border)] bg-[var(--card)] p-6 rounded-sm space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border)] pb-2">
          <div>
            <h2 class="text-lg font-bold">山域探勘決策模型（13 步）</h2>
            <p class="text-xs text-[var(--muted-foreground)]">從地圖模型、微地形到撤退與更新認知的完整推論程序</p>
          </div>
          <a href={`${base}/methodology/`} class="text-xs text-[var(--primary)] hover:underline">
            深入方法論 →
          </a>
        </div>

        <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4 pt-2">
          {methodology.thirteenSteps.map(step => (
            <div class="border border-[var(--border)] bg-[var(--surface)] p-3 rounded-xs space-y-1">
              <div class="flex items-center gap-1.5 font-mono text-xs text-[var(--primary)]">
                <span>{step.no}</span>
                <span>{step.en}</span>
              </div>
              <h3 class="text-xs font-semibold text-[var(--foreground)]">{step.zh}</h3>
              <p class="text-[11px] text-[var(--muted-foreground)] leading-normal">{step.note}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* Section 3: Diagnostic 10 dimensions */}
    {diagnostic && (
      <section id="diagnostic-preview" class="space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border)] pb-2">
          <div>
            <h2 class="text-lg font-bold">探勘能力模型（10 面向）</h2>
            <p class="text-xs text-[var(--muted-foreground)]">透過自評剖面辨識個人能力斷層與對應強化章節</p>
          </div>
          <a href={`${base}/diagnostic/`} class="text-xs text-[var(--primary)] hover:underline">
            進行完整自評 →
          </a>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          {diagnostic.dimensions.map(dim => (
            <div class="border border-[var(--border)] bg-[var(--card)] p-3 rounded-sm space-y-1.5">
              <div class="font-mono text-xs text-[var(--primary)] uppercase">{dim.key}</div>
              <h3 class="text-sm font-semibold">{dim.name}</h3>
              <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">{dim.detail}</p>
              <div class="pt-1 flex flex-wrap gap-1">
                {dim.chapters.map(c => (
                  <a href={`${base}/curriculum/${c}/`} class="text-[10px] text-[var(--primary)] hover:underline">
                    {c}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* Section 4: Level 1-6 definition */}
    {diagnostic && (
      <section id="levels-preview" class="border border-[var(--border)] bg-[var(--card)] p-6 rounded-sm space-y-4">
        <h2 class="text-lg font-bold">探勘能力分級 Level 1–6</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {diagnostic.levels.map(lvl => (
            <div class="border border-[var(--border)] bg-[var(--surface)] p-3 rounded-xs space-y-1.5">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs text-[var(--primary)]">LEVEL {lvl.level}</span>
                <h3 class="text-xs font-semibold text-[var(--foreground)]">{lvl.name}</h3>
              </div>
              <p class="text-xs text-[var(--muted-foreground)]">{lvl.detail}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
